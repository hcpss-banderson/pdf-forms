---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { frontmatter } = Astro.props;
import policyUrl from "../../utils/policyUrl.ts";
import PageHeader from "../components/PageHeader.astro";
import PageFooter from "../components/PageFooter.astro";
import PolicyReference from "../components/PolicyReference.astro";
import * as fs from 'fs';

// Add shared frontmatter from the index file.
const path = frontmatter.file.replace(/\/[a-z]{2}\.mdx/, "/index.mdx")
if (fs.existsSync(path)) {
    const sharedFrontmatter = await import(path);
    for (const [key, value] of Object.entries(sharedFrontmatter.frontmatter)) {
        frontmatter[key] = value;
    }
}
const style_path = frontmatter.file.replace(/\/[a-z]{2}\.mdx/, "/style.css")
console.log(style_path);
---
<html lang={lang}>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{frontmatter.title}</title>
        <link href="https://fonts.googleapis.com/css?family=Open+Sans:600,800" rel="stylesheet">
        <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro" rel="stylesheet">
        <link rel="stylesheet" type="text/css" href="./style.css">
        {fs.existsSync(style_path) && <link rel="stylesheet" type="text/css" href={style_path} />}
    </head>
    <body>
        <PageHeader title={frontmatter.title || frontmatter.form_id} subtitle={frontmatter.subtitle} />
        <main>
            <slot />
            <PolicyReference policies={frontmatter.policy_references} />
        </main>
        <PageFooter id={frontmatter.form_id} version={frontmatter.form_version} />
    </body>
</html>
<style is:global>
    body {
        font-family: "Source Sans Pro",sans-serif;
    }

    * {
        box-sizing: border-box;
    }
    .field-wrapper + .field-wrapper {
        margin-top: 0.5em;
    }
</style>
