---
import FormElement from "../../components/FormElement.astro";
import Grid from "../../components/layout/grid/Grid.astro";
import InputFieldCell from "../../components/form/fields/InputFieldCell.astro";
import RadiosFieldCell from "../../components/form/fields/RadiosFieldCell.astro";
import RadiosField from "../../components/form/fields/RadiosField.astro";
import CheckboxesField from "../../components/form/fields/CheckboxesField.astro";
import CheckboxField from "../../components/form/fields/CheckboxField.astro";
import SchoolSelectFieldCell from "../../components/form/fields/SchoolSelectFieldCell.astro";
import GradeSelectFieldCell from "../../components/form/fields/GradeSelectFieldCell.astro";
import Heading from "../../components/Heading.astro";
import Section from "../../components/layout/Section.astro";
import Break from "../../components/layout/Break.astro";
import Cell from "../../components/layout/grid/Cell.astro";
import FieldSet from "../../components/form/fields/FieldSet.astro";
import InputField from "../../components/form/fields/InputField.astro";
import TextAreaField from "../../components/form/fields/TextAreaField.astro";
import ReadonlySection from "../../components/ReadonlySection.astro";
import Trans from "../../components/Trans.astro";
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
import { ui } from './ui.ts'
const t = useTranslations(lang, ui);
---
<FormElement>
    <Grid>
        <InputFieldCell labelDisplay="block" label={t("Full Name of Student")} name="students_name" span={4} />
        <InputFieldCell labelDisplay="block" label={t("Contact #1 Parent/Guardian’s Name ")} name="parent_name1" span={4} />
        <InputFieldCell labelDisplay="block" label={t("Contact #1 Phone Numbe")} name="contact_number1" span={4} />
        <InputFieldCell labelDisplay="block" label={t("Home Address")} name="home_address" span={4} />
        <InputFieldCell labelDisplay="block" label={t("Contact #2 Parent/Guardian’s Name")} name="parent_name2" span={4} />
        <InputFieldCell labelDisplay="block" label={t("Contact #2 Phone Numbe")} name="contact_number2" span={4} />
        <InputFieldCell labelDisplay="block" label={t("City")} name="city" span={2} />
        <InputFieldCell labelDisplay="block" label={t("State")} name="state" span={2} />
        <InputFieldCell labelDisplay="block" label={t("Zip Code")} name="zip" span={2} />
        <InputFieldCell labelDisplay="block" label={t("Name of School")} name="school" span={4} />
        <InputFieldCell labelDisplay="block" label={t("Grade")} name="grade" span={2} />
        <InputFieldCell labelDisplay="block" label={t("Childcare Provider Name")} name="childcare_provider_name" span={4} />
        <InputFieldCell labelDisplay="block" label={t("Childcare Provider Address")} name="childcare_provider_address" span={4} />
        <InputFieldCell labelDisplay="block" label={t("Bus Number")} name="bus_number" span={4} />
        <InputFieldCell labelDisplay="block" label={t("Childcare Provider License Number")} name="childcare_provider_licence_number" span={4} />
        <InputFieldCell labelDisplay="block" label={t("Childcare Provider Contact Number")} name="childcare_provider_contact_number" span={4} />
        <Cell>
            <CheckboxesField name="transportation_requested_for" help="All" label={t("Transportation is requested for (check all that apply)")} options={["AM", "PM"]} />
        </Cell>
    </Grid>

    <FieldSet>
        <Grid>
            <Cell>
                <Trans set:html={t('I understand that space available bus service may be terminated on short notice if space is no longer available on the bus. This notice may be as short as one day.')} />
            </Cell>
            <InputFieldCell label={t("Signature of Parent/Guardian:")} name="signature1" span={8} />
            <InputFieldCell label={t("Date")} name="date1" span={4} />
        </Grid>
    </FieldSet>
    <FieldSet>
        <Grid>
            <Cell>
                <Trans set:html={t('I acknowledge that the provider listed must be included as an emergency contact in Family File and that the request may be denied if they are not.')} />
            </Cell>
            <InputFieldCell label={t("Signature of Parent/Guardian:")} name="signature2" span={8} />
            <InputFieldCell label={t("Date")} name="date2" span={4} />
        </Grid>
    </FieldSet>

    <ReadonlySection>
        <Heading level={3}>{t("For School Office Use Only")}</Heading>
        <CheckboxField name="confirmed_ost" label={t("Confirmed with OST Area Manager that there is space available on the bus, by phone or email.")} />
    </ReadonlySection>
</FormElement>
