---
import FormElement from '../../components/FormElement.astro';
import Grid from '../../components/layout/grid/Grid.astro';
import InputField from '../../components/form/fields/InputField.astro';
import InputFieldCell from '../../components/form/fields/InputFieldCell.astro';
import RadiosFieldCell from '../../components/form/fields/RadiosFieldCell.astro';
import Section from '../../components/layout/Section.astro';
import Heading from '../../components/Heading.astro';
import Stripes from '../../components/form/fields/Stripes.astro';
import YesNoListTable from '../../components/form/fields/YesNoListTable.astro';
import ReadonlySection from '../../components/ReadonlySection.astro';
import Cell from '../../components/layout/grid/Cell.astro';
import SchoolSelectFieldCell from '../../components/form/fields/SchoolSelectFieldCell.astro';
import GradeSelectFieldCell from '../../components/form/fields/GradeSelectFieldCell.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
import { ui } from './ui.ts'
const t = useTranslations(lang, ui);
---
<FormElement>
    <Grid>
        <InputFieldCell type="date" label={t("Date")} grow={false} />
        <InputFieldCell label={t("Child's Name")} name="childs_name" span={8} />
        <InputFieldCell type="date" label={t("Date of Birth")} name="date_of_birth" span={4} />
        <SchoolSelectFieldCell label={t("Entering School")} grow={true} span={8} />
        <GradeSelectFieldCell label={t("Entering Grade")} grow={true} span={4} />
        <InputFieldCell label={t("Last School Attended with City/State")} />
        <RadiosFieldCell label={t("Has Your Child Ever Attended a Maryland Public School?")} options={[t("Yes"), t("No")]} />
    </Grid>
    <Section>
        <Heading>{t("Contact Information")}</Heading>
        <Grid>
            <InputFieldCell label={t("Name of Person giving information")} span={8} />
            <InputFieldCell label={t("Relationship")} span={4} />
            <InputFieldCell type="tel" name={t("Phone Number")} label={t("What is the best phone number to reach you at while your student is at school?")} />
            <InputFieldCell type="email" name={t("Email Address")} label={t("If you like to be contacted by email, please provide best email address")} />
            <InputFieldCell type="tel" name={t("Cell Phone Number")} label={t("If you would like us to reach you by text, please provide cell phone number")} />
        </Grid>
    </Section>
    <Section>
        <Heading>{t("Medical Information")}</Heading>
        <Grid>
            <RadiosFieldCell label={t("Does the student have a physician?")} options={[t("Yes"), t("No")]} />
            <InputFieldCell name={t("Physician Name and Phone Number")} label={t("Name and telephone number of physician")} />
            <RadiosFieldCell label={t("Do you need help finding a physician?")} options={[t("Yes"), t("No")]} />
            <InputFieldCell type="date" label={t("Date of last Physical Exam")} span={6} />
            <InputFieldCell type="date" label={t("Date of last Dental Exam")} span={6} />
            <InputFieldCell type="date" label={t("Date of last Vision Exam")} span={6} />
            <RadiosFieldCell label={t("Health Insurance Coverage?")} options={[t("Yes"), t("No")]} span={6} />
        </Grid>
    </Section>
    <Section>
        <Heading>{t("Health History")}</Heading>
        <Grid>
            <RadiosFieldCell
                    label={t("Will the student require medication to be given at school?")}
                    help={t("if YES, a Medication Order Form must be completed for each prescription and over the counter medication to be given during school.")}
                    options={[t("Yes"), t("No")]} />
            <InputFieldCell label={t("What medications are taken at home?")} />
        </Grid>
    </Section>
    <Section>
        <Heading>{t("Medical Concerns")}</Heading>
        <Stripes>
            <YesNoListTable label={t("Allergies")} />
            <YesNoListTable label={t("Is the NUT-FREE table required for this student?")} showList={false} />
            <YesNoListTable label={t("Medical Conditions")} help={t("For example: ADHD, Diabetes, Seizures, Asthma, Cardiac, Blood Disorders, Cancer, etc.")} />
            <YesNoListTable label={t("Hospitalizations or Operations")} />
            <YesNoListTable label={t("Physical Handicapping Conditions")} />
            <YesNoListTable label={t("Activity Restrictions")} help={t("If yes, a Physical Education Activity Restriction form must be completed by a physician.")} showList={false} />
            <YesNoListTable label={t("Assistive Devices")} />
            <YesNoListTable label={t("Mental Health Issues")} />
            <YesNoListTable label={t("Speech Difficulties/Developmental Delays")} />
            <YesNoListTable label={t("Vision Difficulties")} help={t("For example: Wears Glasses or Contacts, Crossed Eyes, etc.")} showList={false} />
            <YesNoListTable label={t("Hearing Difficulties")} showList={false} />
            <YesNoListTable label={t("Any Other Health Concerns")} help={t("For example: eating/sleeping habits, posture, skin/teeth, weight, daytime wetting/stooling concerns, etc.")} />
        </Stripes>
    </Section>
    <ReadonlySection>
        <Heading>{t("Health Room Use Only")}</Heading>
        <Grid>
            <Cell span={6}>
                <Heading level={3}>{t("Received")}</Heading>
                <InputField type="date" label={t("Form Received Date")} disabled={true} />
                <InputField name="Form Received Signature" label={t("Signature")} disabled={true} />
            </Cell>
            <Cell span={6}>
                <Heading level={3}>Reviewed</Heading>
                <InputField type="date" label={t("Form Reviewed Date")} disabled={true} />
                <InputField type="date" name="Form Reviewed Signature" label={t("Signature")} disabled={true} />
            </Cell>
        </Grid>
    </ReadonlySection>
</FormElement>