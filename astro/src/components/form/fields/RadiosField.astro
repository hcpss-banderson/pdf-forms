---
import { getLangFromUrl, useTranslations } from '../../../i18n/utils';
const lang = getLangFromUrl(Astro.url);
import { ui } from '../../../i18n/ui'
const t = useTranslations(lang, ui);
interface Props {
  name: string,
  help?: string,
  label: string,
  labelDisplay?: string,
  options?: string[],
  required?: boolean,
  align?: string,
  inlineOptions?: boolean,
}
const {
  required = false,
  help = '',
  labelDisplay = 'inline',
  name,
  align = 'left',
  options = {"yes": t("yes"), "no": t("no")},
  label,
  inlineOptions = true,
} = Astro.props
---
<div class={labelDisplay === 'block' ? 'field-wrapper field-wrapper-block' : 'field-wrapper'}>
  {labelDisplay !== 'hidden' && (
    <div class="label-wrapper">
      {label}
      {help && (
        <br>
        <small>{help}</small>
      )}
    </div>
  )}
  <div class={'input-wrapper align-' + align + (inlineOptions ? ' inline-field' : ' block-field')}>
    {Object.entries(options).map(([key, value]) => (
      <div class={'radio-wrapper radio-' + (inlineOptions ? 'inline' : 'block')}>
        <input
            type="radio"
            id={name ? name + '[' + key + ']' : label + '[' + key + ']'}
            name={name ? name : label} value={key}
        /><label for={name ? name + '[' + key + ']' : label + '[' + key + ']'}>{value}</label>
      </div>
    ))}
  </div>
</div>
<style>
label {
  white-space: nowrap;
}
.radio-wrapper {
  white-space: nowrap;
}
.radio-block {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}
.inline-field {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}
.inline-field.align-right {
  justify-content: flex-end;
  min-width: max-content;
}

.radio-wrapper.radio-inline {
  display: inline-block;
}

.field-wrapper {
  display: flex;
  align-items: center;
}

.field-wrapper-block {
  display: block;
}

.input-wrapper {
  text-align: right;
  flex-grow: 1;
}
.input-wrapper.align-left {
  text-align: left;
}
.input-wrapper.align-right {
  text-align: right;
}
</style>
