---
interface Props {
    name: string,
    label: string,
    id: string,
    val: string
}
const { name, label, id, value} = Astro.props;
---
<div class="checkbox-wrapper">
    <input
        type="checkbox"
        id={id}
        name={name}
        value={value}
    /><label for={id}>{label}</label>
</div>
<style>
    .checkbox-wrapper {
        flex-basis: auto;
        white-space: nowrap;
    }
</style>