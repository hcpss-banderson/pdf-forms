---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
import { ui } from '../i18n/ui'
const t = useTranslations(lang, ui);

interface Props {
    id?: string,
    version?: string
}
const { id = 'mario', version = 'zero' } = Astro.props
---
<footer>
    <p>Howard County Public School System | {t('form')}: {id}-{version}</p>
</footer>
<style>
footer {
    padding: 1rem;
    margin-top: 2rem;
    text-align: center;
}
</style>
