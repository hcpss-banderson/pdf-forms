---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const lang = getLangFromUrl(Astro.url);
import { ui } from '../i18n/ui'
const t = useTranslations(lang, ui);
import policyUrl from "../../utils/policyUrl.ts";
interface Props {
    policies: string[]
}
const { policies = [] } = Astro.props;
---
{policies.length > 0 && (
    <p>
        {t('related.policies')}:
        {policies.map((policy, i) => (
            <span>{(i !== 0) && ', '}<a href={policyUrl(policy)}>{policy}</a></span>
        ))}
    </p>
)}
